# Copy to .env.local. Demo mode is on until DEMO_MODE=0.

SESSION_SECRET=replace-with-a-long-random-string
DEMO_MODE=1
DEMO_ADMIN_PASSWORD=efi-staff-demo
DEMO_STUDENT_PASSWORD=efi-student-demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase service role. Leave blank to use the local data/db.json store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in. Create an OAuth client and set the redirect to
# {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Passkeys. Use the hostname only, no scheme and no port for localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Email codes. Without a key, demo mode shows the code on the sign-in screen.
RESEND_API_KEY=
EMAIL_FROM=EFI Institute <onboarding@resend.dev>

# Shared secret for the Shopify enrollment webhook.
EFI_SHOPIFY_SECRET=
